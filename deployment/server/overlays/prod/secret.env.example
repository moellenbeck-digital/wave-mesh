# Kopieren nach secret.env (nicht versioniert, Modus 600) und ausfüllen.
#
# Die Datenbank aus der Basis. Beide Zeilen tragen dasselbe Passwort, sonst
# kommt der Control-Server nicht an sein Postgres.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://wave:PASSWORT@wave-postgres:5432/wave

# Mit einem verwalteten Dienst stattdessen dessen Adresse hier eintragen,
# POSTGRES_PASSWORD weglassen und den Pod im Overlay herauspatchen -- ein
# einzelnes Volume ohne Backup ist der Wave selbst.
# DATABASE_URL=postgres://wave:PASSWORT@postgres.example.internal:5432/wave

# Der Signaturschlüssel der Netmaps. Jedes Gerät pinnt ihn bei der Anmeldung:
# geht er verloren, muss sich jedes Gerät neu anmelden. 32 rohe Bytes in
# base64 -- der Seed eines Ed25519-Schlüssels:
#   openssl rand -base64 32
WAVE_NETMAP_SIGNING_KEY=

# Der Schlüssel, mit dem die DNS-Provider-Tokens versiegelt in der Datenbank
# liegen (D7). Ohne ihn verweigert `set-dns-provider`, statt im Klartext
# abzulegen. Sein Verlust kostet niemanden seinen Wave, aber die hinterlegten
# Tokens sind dann nicht mehr zu öffnen und müssen neu gesetzt werden.
#   openssl rand -base64 32
# WAVE_DNS_SECRET=

# Optional: Google-Login. Ohne beide Werte gibt es den Provider schlicht nicht,
# und es bleibt beim Passwort-Login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
