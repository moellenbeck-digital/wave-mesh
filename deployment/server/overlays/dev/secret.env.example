# Kopieren nach secret.env (nicht versioniert) und ausfüllen.
#
# Passwort der mitgelieferten Entwicklungs-Datenbank. Steht in beiden Zeilen
# dasselbe, sonst kommt der Control-Server nicht an sein Postgres.
POSTGRES_PASSWORD=wave
DATABASE_URL=postgres://wave:wave@wave-postgres:5432/wave

# Optional. Ohne den Schlüssel erzeugt der Entwicklungsmodus bei jedem Start
# einen flüchtigen, und jedes Gerät muss sich danach neu anmelden. Es sind
# 32 rohe Bytes in base64 -- der Seed eines Ed25519-Schlüssels:
#   openssl rand -base64 32
# WAVE_NETMAP_SIGNING_KEY=

# Optional, für Zertifikate (D7): 32 Bytes base64, damit die DNS-Tokens
# versiegelt abgelegt werden können.
#   openssl rand -base64 32
# WAVE_DNS_SECRET=
