# Kopieren nach secret.env (nicht versioniert) und ausfüllen.
#
# Der Pre-Auth-Key, mit dem sich der Connector ohne Browser anmeldet. Er ist
# einmal sichtbar, gespeichert wird beim Server nur sein SHA-256:
#   bun apps/control/src/admin.ts auth-key <wave> connector --reusable
WAVE_AUTH_KEY=wavekey-...
