# Als `.env` neben die docker-compose.yml kopieren. Die Kopie nie committen.

# Der Control-Server des Waves.
WAVE_CONTROL_URL=https://wave.example.com
# Auf dem Server: bun apps/control/src/admin.ts auth-key <wave> synology
WAVE_AUTH_KEY=replace-with-your-pre-auth-key
# Das DNS-Suffix des Waves; darunter hängen die Namen unten.
WAVE_DOMAIN=home.wave.example.com

# Die ganze Menge der Dienste, die dieses NAS beantwortet.
WAVE_SERVICES=ha,paperless,openclaw
# Davon die ohne TLS (angezeigt als http://). Passend zum Caddyfile.
WAVE_SERVICES_NO_TLS=ha,paperless,openclaw

# Wohin Caddy jeden Namen weiterreicht, Host:Port aus Sicht des NAS.
HA_UPSTREAM=192.168.178.142:8123
PAPERLESS_UPSTREAM=192.168.178.59:8777
# Eine Beispieladresse aus dem Dokumentationsbereich; die eigene eintragen.
OPENCLAW_UPSTREAM=192.0.2.10:18789

# Nur falls 172.31.250.0/24 schon von einem anderen Docker-Netz belegt ist.
#WAVE_SUBNET_PREFIX=172.31.250
# auto | nft | iptables
#WAVE_NETFILTER=auto
# Abstand zwischen zwei Meldungen der Dienste, in Millisekunden.
#WAVE_SYNC_INTERVAL_MS=60000
# Das in README.md, Schritt 1 gebaute Image.
#WAVE_IMAGE=wave-synology:local
