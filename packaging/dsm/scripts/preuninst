#!/bin/sh
# Takes the service out before DSM removes the package: the unit points into
# the package's directory, and a unit whose binary is gone restarts forever.
# The enrolment in /var/lib/wave stays, as it does after `wave uninstall`.
#
# DSM has already run `stop` by now. Never fails: this runs on every upgrade
# too, and a failure here would abort the removal.

PATH="/usr/syno/sbin:/usr/syno/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

WAVE="${SYNOPKG_PKGDEST:-/var/packages/wave/target}/wave"
[ -x "$WAVE" ] && "$WAVE" uninstall
exit 0
