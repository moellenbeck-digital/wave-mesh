#!/bin/sh
# Lifecycle of the wave package on Synology DSM 7. DSM calls this as the
# package's own user (conf/privilege: run-as package), because DSM 7 refuses to
# install a package that is not signed by Synology if it wants to run as root.
#
# That user cannot do what the daemon needs root for: the tunnel, the routes,
# the firewall, the TUN device and DSM's certificate store. So the daemon is not
# run from here at all. It runs under systemd, set up once as root with
#
#   sudo /var/packages/wave/scripts/setup
#
# (see docs/DSM.md). From then on systemd carries it, also through reboots, and
# this script only reports on it. That is also why start and stop leave it
# alone: they could not touch it, and Package Center showing the package as
# started or stopped is no statement about the tunnel.

PATH="${PATH:+$PATH:}/usr/syno/sbin:/usr/syno/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

case "$1" in
  start)
    # Nothing to start as this user. Not being set up yet is no reason to fail:
    # DSM would show the package as crashed for something only root can do.
    if ! systemctl cat wave >/dev/null 2>&1; then
      echo "wave: the daemon is not set up yet. Run once as root: sudo /var/packages/wave/scripts/setup"
    fi
    exit 0
    ;;
  stop)
    # The daemon belongs to systemd and to root: `sudo systemctl stop wave`.
    exit 0
    ;;
  status)
    if systemctl is-active --quiet wave; then
      echo "wave is running"
      exit 0
    fi
    if systemctl cat wave >/dev/null 2>&1; then
      # Set up, and not running: stopped by hand, or failed.
      echo "wave is installed as a service, but not running"
      exit 3
    fi
    # Installed and waiting for the one step as root. That is the package's
    # normal state until then, not a failure, and DSM must not read it as one.
    echo "wave is installed; the daemon is not set up yet: sudo /var/packages/wave/scripts/setup"
    exit 0
    ;;
esac

# prestart and prestop: nothing to check.
exit 0
