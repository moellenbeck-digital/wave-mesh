# Environment file for wave-mesh.service.
# Uncomment and adjust as needed.  Loaded with EnvironmentFile=-/etc/wave/wave.env.

# Control socket group (default: wave).
# Users in this group may use `wave up`, `wave status`, etc. without sudo.
#WAVE_SOCKET_GROUP=wave

# Disable the built-in auto-updater explicitly (it is already disabled when the
# binary lives under /usr/bin/, which this package enforces, but the variable
# documents the intent).
#WAVE_AUTO_UPDATE=false
