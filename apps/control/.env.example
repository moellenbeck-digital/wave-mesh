# Control server configuration. Copy to .env and adjust.

WAVE_ENV=development
WAVE_PORT=8080
# Bind address. Keep it off public interfaces while WAVE_DEV_AUTH is on.
WAVE_HOST=0.0.0.0
# Public origin; OAuth redirect URIs are derived from it as
# <WAVE_BASE_URL>/auth/<provider>/callback
WAVE_BASE_URL=http://localhost:8080

DATABASE_URL=postgres://wave:wave@127.0.0.1:5432/wave

# Where the Next.js frontend (apps/web) listens. Set it and this server stops
# rendering HTML: browser routes are redirected to the frontend's pages and
# everything this server does not own itself is proxied there, so :8080 stays
# the only public port. Leave it unset and the plain built-in pages are served.
# WAVE_WEB_URL=http://127.0.0.1:3000

# Accounts with an email address and a password need no configuration; create
# one with:
#   bun src/admin.ts set-password you@example.com
# There is deliberately no signup page.

# Google OIDC. Register the redirect URI above in the Google Cloud console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Any OpenID Connect provider with a discovery document -- written for Pocket
# ID (https://pocket-id.org), Authelia, Authentik or Keycloak work the same.
# Register <WAVE_BASE_URL>/auth/oidc/callback as the redirect URI there. Leave
# the secret out for a public client; PKCE is used either way. For invitations
# the provider has to vouch for the address: in Pocket ID that is the
# "Emails Verified" setting.
# WAVE_OIDC_ISSUER=https://id.example.com
# WAVE_OIDC_CLIENT_ID=
# WAVE_OIDC_CLIENT_SECRET=
# WAVE_OIDC_NAME=Pocket ID

# Password-free login for local development. Opt-in, and ignored entirely when
# WAVE_ENV=production.
WAVE_DEV_AUTH=1
# Networks the development login may be used from (IPv4 CIDRs). Set this
# whenever the server is bound to a public interface -- the login trusts
# whatever address is typed into it.
# WAVE_DEV_AUTH_FROM=100.64.0.0/10,192.168.0.0/16

# Relays handed to every node, as JSON.
# WAVE_RELAYS=[{"id":"a","region":"eu","url":"wss://relay.example.com/relay","stun":{"ip":"203.0.113.1","port":3478}}]

# Signs netmaps; clients pin it. Generate with:
#   bun -e 'console.log(require("@wave/crypto").generateKeyPair("ed25519").privateKey)'
# WAVE_NETMAP_SIGNING_KEY=

# --- certificates (D7) -------------------------------------------------------
# Seals the DNS provider tokens at rest (AES-256-GCM). Without it no credential
# can be stored, which is deliberate: a token in the clear in the database is a
# key to somebody else's domain. Generate with:
#   openssl rand -base64 32
# WAVE_DNS_SECRET=

# Where certificates are ordered from. The default is Let's Encrypt's staging
# directory on purpose -- production rate limits are burnt for a week by one
# mistake, so reaching it is a deliberate act.
# WAVE_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
# Contact address for the ACME account; the CA warns about expiry there.
# WAVE_ACME_CONTACT=you@example.com
