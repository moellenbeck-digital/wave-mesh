  },
  "dependencies": {
    "@wave/crypto": "workspace:*",
    "@wave/proto": "workspace:*",
    "zod": "^4.1.13",
    "@wave/magicsock": "workspace:*",
    "@wave/disco": "workspace:*",
    "@wave/dns": "workspace:*",
    "@wave/ipc": "workspace:*",
    "@wave/i18n": "workspace:*",
    "@wave/tray": "workspace:*"
  },
  "exports": {
    ".": "./src/cli.ts",
    "./api": "./src/api.ts",
    "./state": "./src/state.ts",
    "./certs": "./src/certs.ts"
  }
}
