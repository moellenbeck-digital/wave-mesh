<?xml version="1.0" encoding="utf-8"?>
<!-- English is the base: a phone set to any language without its own folder
     falls back to this one. German lives in values-de. Android picks the folder
     from the system language; there is no switch in the app. -->
<resources>
    <!-- The product name is a name, not a word: it stays the same in every
         language, which is why values-de does not repeat it. -->
    <string name="app_name" translatable="false">wave-mesh</string>

    <string name="connect">Connect</string>
    <string name="disconnect">Disconnect</string>
    <string name="open_enrolment_link">Open the enrolment link</string>
    <string name="control_server_address">control server address</string>
    <string name="log_in">Log in</string>
    <string name="no_wave_yet">This device is in no wave yet. Logging in is the only way in — there is no second one.</string>
    <string name="no_control_connection">no control connection; peers will stop being updated</string>
    <string name="leave_wave">Leave this wave</string>

    <!-- Path of a peer. The core reports "relay", "idle" or the address of the
         direct path; only the words are translated. -->
    <string name="path_none">no fixed path</string>
    <string name="path_relay">relay</string>
    <!-- Nothing sent to this peer lately, so its path is not being measured. -->
    <string name="path_idle">idle</string>
    <!-- %1$s: "relay" or an address, %2$d: round-trip time in milliseconds -->
    <string name="path_with_rtt">%1$s · %2$d ms</string>

    <string name="notification_channel">Tunnel status</string>
    <string name="notification_running">the tunnel is running</string>
    <string name="login_failed">login failed</string>
    <string name="logout_failed">logout failed</string>

    <!-- Shown once before the first connect. Same statement as the iOS app. -->
    <string name="disclosure_intro">wave-mesh sets up a VPN on this device that connects it with the other devices in your wave.</string>
    <string name="disclosure_connects_title">What it connects</string>
    <string name="disclosure_connects_body">Traffic between your devices runs encrypted with WireGuard, directly from device to device. Where no direct path is possible, it runs encrypted through a relay of your wave.</string>
    <string name="disclosure_control_title">What your control server learns</string>
    <string name="disclosure_control_body">To join a wave, the app sends the control server you enter this device\'s name, its public keys and the network addresses it can be reached at. Neither the control server nor the relay can read your traffic.</string>
    <string name="disclosure_ours_title">What we do not do</string>
    <string name="disclosure_ours_body">The app sends no data to Moellenbeck Digital. It contains no analytics and no advertising, and no data is sold or passed on.</string>
    <string name="disclosure_next">In the next step Android asks whether wave-mesh may set up a VPN connection.</string>
    <string name="disclosure_continue">Continue</string>
</resources>
